# Copy this file to .env. Keep .env private and never commit real keys.
# Local gameplay works without credentials; remote steps need only their section.

# --- Local app (npm start) --------------------------------------------------
HOST=127.0.0.1
PORT=8788

# Sepolia RPC for server-side reads. Falls back to PublicNode when unset.
#SUMO_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployment writes app/deployment/sepolia.json automatically. Set these only
# for a manual setup or a Render service using an existing deployment.
#SUMO_COIN_ADDRESS=
#SUMO_COLLECTION_ADDRESS=

# --- Sepolia deployment (npm run deploy:sepolia) ---------------------------
#SEPOLIA_RPC_URL=
# 0x + 64 hex characters. Fund this account with Sepolia ETH from a faucet.
#DEPLOYER_PRIVATE_KEY=
# Optional public address; defaults to the deployer address.
#SUMO_CLAIM_SIGNER_ADDRESS=

# --- On-chain SUMO claims ---------------------------------------------------
# Private key matching claimSigner in the deployed SumoCoin contract.
# Anyone holding it can issue mint vouchers, so keep it secret.
#SUMO_CLAIM_SIGNER_KEY=

# --- Original collection uploads (npm run upload:pinata) -------------------
# Pinata JWT with Files:write, created at app.pinata.cloud.
#PINATA_JWT=

# --- Optional metadata-folder workflow (npm run metadata) ------------------
# Not required by upload:pinata, which writes direct per-token IPFS URIs.
#IPFS_IMAGE_CID=
#SUMO_EXTERNAL_URL=http://127.0.0.1:8788
#SUMO_COLLECTION_BASE_URI=ipfs://<metadataFolderCid>/

# --- Later public deployment ------------------------------------------------
# Used only for Render API/CLI automation, never by the local game server.
# The Render blueprint itself is render.yaml; no deployment runs automatically.
#RENDER_API_KEY=
